# Any OpenAI-compatible chat endpoint. Default: Gemma 4 on Cloudflare Workers AI (free 10,000 neurons a day).
# Contract: docs/api-backend.md §3-4.
AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1
AI_API_KEY=
EXTRACT_MODEL=@cf/google/gemma-4-26b-a4b-it
GRADE_MODEL=@cf/google/gemma-4-26b-a4b-it
# Stop calling the model a little before Cloudflare's daily 10,000 and answer offline instead.
DAILY_NEURONS=9000

# Development only: the same Gemma 4 on Google's Gemini API (docs/api-backend.md §3). Its terms rule it
# out for release.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=
# EXTRACT_MODEL=gemma-4-26b-a4b-it
# GRADE_MODEL=gemma-4-26b-a4b-it
# NEURONS_PER_M_IN=0
# NEURONS_PER_M_OUT=0
# AI_JSON_SCHEMA=0
