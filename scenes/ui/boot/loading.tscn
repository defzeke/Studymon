[sub_resource type="Shader" id="Shader_stripes"]
code = "shader_type canvas_item;

varying vec2 local_pos;

void vertex() {
	local_pos = VERTEX;
}

void fragment() {
	float band = fract((local_pos.x + local_pos.y - TIME * 24.0) / 26.0);
	float stripe = smoothstep(0.5, 0.54, band) - smoothstep(0.96, 1.0, band);
	COLOR.rgb = mix(COLOR.rgb, vec3(0.9098, 0.9412, 0.9176), stripe * 0.4);
}
"

